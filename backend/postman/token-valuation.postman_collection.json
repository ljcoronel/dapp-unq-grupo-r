{
  "info": {
    "name": "Token Valuation API",
    "description": "Coleccion de pruebas para la API de valuacion de tokens de jugadores (especificacion 012-token-valuation). Incluye configuracion de estrategias, consulta de tenencias, historial y recalculo manual.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Estrategias",
      "item": [
        {
          "name": "Configurar estrategia (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estrategia\": \"ESTRATEGIA_A\",\n  \"pesos\": {\n    \"goals\": 30.0,\n    \"assists\": 25.0,\n    \"passSuccessPercentage\": 15.0,\n    \"aerialsWon\": 15.0,\n    \"timesManOfTheMatch\": 15.0\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{usuarioId}}/strategy",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{usuarioId}}", "strategy"]
            },
            "description": "Configura una estrategia. Si es la primera vez, se activa como ACTUAL y valua de inmediato. Si ya existe una actual, se programa como PENDIENTE para la proxima ventana dominical."
          },
          "response": [
            {
              "name": "200 OK - Configuracion inicial exitosa (ACTUAL)",
              "originalRequest": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
