    {
      "name": "Cotizaciones",
      "item": [
        {
          "name": "Recalculo manual (POST)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/quotes/recalculate",
              "host": ["{{baseUrl}}"],
              "path": ["quotes", "recalculate"]
            },
            "description": "Endpoint publico sin autenticacion. Ejecuta scraping de 50 jugadores, promueve estrategias pendientes y recalcula las tenencias de todos los usuarios."
          },
          "response": [
            {
              "name": "200 OK - Recalculo completado",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/quotes/recalculate",
                  "host": ["{{baseUrl}}"],
                  "path": ["quotes", "recalculate"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"COMPLETED\",\n  \"playersScraped\": 50,\n  \"recalculatedHoldings\": 50,\n  \"executedAt\": \"2026-10-21T19:00:00Z\"\n}"
            },
            {
              "name": "503 Service Unavailable - Fallo operativo en scraping o recalculo",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/quotes/recalculate",
                  "host": ["{{baseUrl}}"],
                  "path": ["quotes", "recalculate"]
                }
              },
              "status": "Service Unavailable",
              "code": 503,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"No se pudo completar el scraping o el recalculo; se conserva la ultima valuacion valida. Snapshot de jugadores vacio o incompleto\"\n}"
            }
          ]
        }
